PORT=3001
SAMBA_PATH=../mock/samba
PHP_API_URL=http://localhost:8080

# AMFPHP(レガシー)経由のAPI呼び出し設定。詳細はdocs/AMFPHP連携.md参照
# gateway.phpのURLを直接指定したい場合のみ設定（未設定ならPHP_API_URL+固定パスから自動生成）
# AMFPHP_GATEWAY_URL=
# target: 0=プライマリDB / 0以外=レプリカDB（AuthSession::connectionDb参照）。基本0のままでよい
AMFPHP_TARGET=0
# userid/key: t_mng_admin.id / certificationkey と照合される（AuthSession::checkLogin参照）。
# 実際にExpress用に発行してもらう値は未確定のためTODOのまま
AMFPHP_USERID=TODO
AMFPHP_KEY=TODO
